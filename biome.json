{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "*.ts",
      "*.json",
      "!test/fixtures",
      "!package-lock.json",
      "!npm-shrinkwrap.json",
      "!node_modules",
      "!dist",
      "!coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": [
        "test/parse/iac-*.test.ts",
        "test/cli/terraform.e2e.test.ts",
        "test/action/*.test.ts"
      ],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ],
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  }
}
